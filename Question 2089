class Solution {
public:
    vector<int> targetIndices(vector<int>& nums, int target) {
         vector<int> ans;
       for(int i=0;i<nums.size()-1;i++){
    for(int j=0;j<nums.size()-i-1;j++){
            if(nums[j]>nums[j+1]){
                int a =nums[j];
                nums[j]=nums[j+1];
                nums[j+1]=a;
            }
    }
        }
        for(int j=0;j<nums.size();j++){
            if (nums[j]==target){
              ans.push_back(j);
            }
        }
        return ans;
    }
};
