class Solution {
public:
    int maxSubArray(vector<int>& nums) {

        int Maxsum=INT_MIN;
        int currsum=0;
        for(int i=0;i<nums.size();i++){
            currsum += nums[i];
            Maxsum = max(currsum,Maxsum);
            if(currsum<0)
            currsum=0;
        }
        
   return Maxsum;
    }
};
