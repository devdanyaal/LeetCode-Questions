class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int target) {
        
        int l=fol(nums,target);
        int r=foR(nums,target);
        return {l,r};
    }
    private :int fol(vector<int>& nums, int target){
        int i=-1,L=0,H=nums.size()-1;
        while(L<=H){
            int M=(L+H)/2;
            if(nums[M]==target){
                i=M;
                H=M-1;
            }
            else if( nums[M]< target){
                L=M+1;
            }
            else{
                H=M-1;
            }

        }
        return i;
    }

 private : int foR(vector<int>& nums, int target){
        int j=-1,L=0,H=nums.size()-1;
         while(L<=H){
            int M=(L+H)/2;
            if(nums[M]==target){
                j=M;
                L=M+1;
            }
            else if( nums[M]< target){
                L=M+1;
            }
            else{
                H=M-1;
            }

        }
        return j;
    }   

};
